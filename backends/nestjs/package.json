    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "engines": {
    "node": ">=20"
