NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://siuden_user:change-me@127.0.0.1:3306/siuden_retail"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN=8h
ADMIN_FRONTEND_URL="http://localhost:5173,http://localhost:3000"

# Only used by `pnpm prisma:seed` to create/update the first administrator.
SEED_ADMIN_EMAIL=admin@rubi.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME="Administrador Rubi"
# Set true only for an intentional password reset, then set it back to false.
SEED_ADMIN_RESET_PASSWORD=false
